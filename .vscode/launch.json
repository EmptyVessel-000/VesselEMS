{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "启动后端 - VesselEMSApplication",
      "request": "launch",
      "mainClass": "vesselems.VesselEMSApplication",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "args": "--spring.profiles.active=dev"
    },
    {
      "type": "pwa-node",
      "name": "启动前端 - npm run dev",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "启动全部",
      "configurations": [
        "启动后端 - VesselEMSApplication",
        "启动前端 - npm run dev"
      ]
    }
  ]
}
